---
// 奉天F4Club — Main Layout v2
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  lang?: 'zh' | 'en';
}

const user = (Astro.locals as any).user;
const { title = '奉天F4Club', description = '前同事们的秘密基地', lang = 'zh' } = Astro.props;
const fullTitle = title === '奉天F4Club' ? title : `${title} — 奉天F4Club`;

const navLinks = [
  { href: '/',                 emoji: '💬', zh: '帖子', en: 'Posts',    colorVar: 'var(--accent)' },
  { href: '/games',            emoji: '🎲', zh: '在线游戏', en: 'Games', colorVar: 'var(--cat-gaming)' },
  { href: '/category/gaming',  emoji: '🎮', zh: '游戏', en: 'Gaming',   colorVar: 'var(--cat-gaming)' },
  { href: '/category/movies',  emoji: '🎬', zh: '电影', en: 'Movies',   colorVar: 'var(--cat-movies)' },
  { href: '/category/sports',  emoji: '🏀', zh: '运动', en: 'Sports',   colorVar: 'var(--cat-sports)' },
  { href: '/category/english', emoji: '📖', zh: '英语', en: 'English',  colorVar: 'var(--cat-english)' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="preload" as="image" href="/assets/f4club-hero.webp" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <ClientRouter />
  <title>{fullTitle}</title>
</head>
<body>

<!-- Navigation -->
<nav class="nav">
  <div class="nav-inner container">
    <!-- Brand -->
    <a href="/" class="nav-brand">
      <span class="brand-icon">F4</span>
      <span class="brand-sub">Club</span>
      <span class="brand-dot"></span>
    </a>

    <!-- Links -->
    <div class="nav-links" id="nav-links">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link ${currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href + '/')) ? 'active' : ''}`}
          style={`--link-color: ${link.colorVar}`}
        >
          <span class="nav-link-emoji">{link.emoji}</span>
          <span class="nav-link-text">{lang === 'zh' ? link.zh : link.en}</span>
        </a>
      ))}
    </div>

    <!-- Actions -->
    <div class="nav-actions">
      <button class="nav-icon-btn" id="lang-toggle" title="切换语言 / Switch Language">
        <span id="lang-label">{lang === 'zh' ? 'EN' : '中'}</span>
      </button>
      <button class="nav-icon-btn" id="theme-toggle" title="切换主题">
        <span id="theme-icon">🌙</span>
      </button>

      {user ? (
        <div class="nav-user-area">
          <a href="/post/new" class="btn btn-primary btn-sm nav-post-btn">
            <span>✦</span>
            <span>{lang === 'zh' ? '发帖' : 'Post'}</span>
          </a>
          <a href={`/member/${user.nickname}`} class="nav-avatar">
            <span class="nav-avatar-emoji">{user.avatar_emoji}</span>
            <span class="nav-avatar-name">{user.nickname}</span>
          </a>
          <a href="/api/auth/logout" class="nav-logout" title={lang === 'zh' ? '退出' : 'Logout'}>⏏</a>
        </div>
      ) : (
        <a href="/login" class="btn btn-ghost btn-sm">
          {lang === 'zh' ? '登录' : 'Login'}
        </a>
      )}

      <button class="nav-hamburger" id="nav-hamburger" aria-label="菜单">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Main -->
<main class="main-content">
  <slot />
</main>

<!-- Footer -->
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-f4">F4</span>Club
    </div>
    <p class="footer-text">
      {lang === 'zh' ? '奉天·前同事们的秘密基地 🎮🎬🏀📖' : 'Fengtian · Our Secret Hangout 🎮🎬🏀📖'}
    </p>
    <p class="footer-copy">© 2026 F4Club</p>
  </div>
</footer>

<script is:inline>
(function(){
  const applyThemeIcon = () => {
    const themeIcon = document.getElementById('theme-icon');
    if (themeIcon) {
      themeIcon.textContent = document.documentElement.getAttribute('data-theme') === 'light' ? '☀️' : '🌙';
    }
  };

  if (localStorage.getItem('theme') === 'light') {
    document.documentElement.setAttribute('data-theme','light');
  }
  applyThemeIcon();
  document.addEventListener('astro:page-load', applyThemeIcon);

  if (!window.__f4clubChromeReady) {
    window.__f4clubChromeReady = true;

    document.addEventListener('click', (event) => {
      const themeBtn = event.target.closest('#theme-toggle');
      if (themeBtn) {
        const isLight = document.documentElement.getAttribute('data-theme') === 'light';
        if (isLight) {
          document.documentElement.removeAttribute('data-theme');
          localStorage.setItem('theme','dark');
        } else {
          document.documentElement.setAttribute('data-theme','light');
          localStorage.setItem('theme','light');
        }
        applyThemeIcon();
        return;
      }

      const langBtn = event.target.closest('#lang-toggle');
      if (langBtn) {
        const url = new URL(window.location.href);
        const cur = url.searchParams.get('lang') || 'zh';
        url.searchParams.set('lang', cur === 'zh' ? 'en' : 'zh');
        window.location.href = url.toString();
        return;
      }

      const ham = event.target.closest('#nav-hamburger');
      if (ham) {
        const navLinks = document.getElementById('nav-links');
        if (!navLinks) return;
        const open = navLinks.classList.toggle('open');
        ham.classList.toggle('open', !!open);
        ham.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
    });
  }

  // Warm up same-site pages shortly before the user opens them.
  const prefetched = window.__f4clubPrefetched || new Set();
  window.__f4clubPrefetched = prefetched;
  const canPrefetch = (anchor) => {
    if (!anchor?.href || anchor.target || anchor.hasAttribute('download')) return false;
    const url = new URL(anchor.href, window.location.href);
    if (url.origin !== window.location.origin) return false;
    if (url.pathname.startsWith('/api/')) return false;
    if (url.pathname === window.location.pathname && url.search === window.location.search) return false;
    return true;
  };
  const prefetchPage = (anchor) => {
    if (!canPrefetch(anchor)) return;
    const url = new URL(anchor.href, window.location.href);
    url.hash = '';
    const key = url.toString();
    if (prefetched.has(key)) return;
    prefetched.add(key);
    fetch(key, {
      method: 'GET',
      credentials: 'same-origin',
      headers: { 'X-F4-Prefetch': '1' },
      priority: 'low',
    }).catch(() => prefetched.delete(key));
  };
  if (!window.__f4clubPrefetchReady) {
    window.__f4clubPrefetchReady = true;
    document.addEventListener('pointerover', (event) => {
      const anchor = event.target.closest('a[href]');
      prefetchPage(anchor);
    }, { passive: true });
    document.addEventListener('focusin', (event) => {
      const anchor = event.target.closest('a[href]');
      prefetchPage(anchor);
    });
    document.addEventListener('touchstart', (event) => {
      const anchor = event.target.closest('a[href]');
      prefetchPage(anchor);
    }, { passive: true });
  }
})();
</script>

<style>
/* ---- NAV ---- */
.nav {
  position: sticky; top: 0; z-index: 100;
  width: 100%;
  max-width: 100vw;
  height: var(--nav-height);
  background: rgba(5,6,8,0.72);
  backdrop-filter: blur(24px) saturate(160%);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  box-shadow: 0 10px 30px rgba(0,0,0,0.22);
}
[data-theme="light"] .nav {
  background: rgba(244,245,251,0.82);
}

.nav-inner {
  height: 100%;
  display: flex;
  align-items: center;
  gap: var(--space-lg);
}

/* Brand */
.nav-brand {
  display: flex; align-items: center; gap: 4px;
  font-weight: 800; font-size: 1.2rem;
  letter-spacing: 0;
  flex-shrink: 0;
  position: relative;
}
.brand-icon {
  background: linear-gradient(135deg, #e94560, #6c5ce7);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 1.35rem;
}
.brand-sub { color: var(--text-secondary); font-weight: 400; font-size: 1rem; }
.brand-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 14px var(--accent-glow);
  animation: pulse-dot 2s ease-in-out infinite;
  flex-shrink: 0;
}
@keyframes pulse-dot {
  0%,100% { opacity:1; transform:scale(1); }
  50% { opacity:0.4; transform:scale(0.7); }
}

/* Nav links */
.nav-links {
  display: flex; align-items: center;
  gap: 2px; flex: 1;
  overflow-x: auto;
  -ms-overflow-style: none; scrollbar-width: none;
}
.nav-links::-webkit-scrollbar { display: none; }

.nav-link {
  display: flex; align-items: center; gap: 5px;
  padding: 6px 12px;
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--text-muted);
  white-space: nowrap;
  transition: all var(--duration-normal) var(--ease-out);
  border: 1px solid transparent;
}
.nav-link-emoji { font-size: 1rem; transition: transform var(--duration-fast) var(--ease-spring); }
.nav-link:hover {
  color: var(--link-color);
  background: rgba(255,255,255,0.07);
  border-color: rgba(255,255,255,0.1);
}
.nav-link:hover .nav-link-emoji { transform: scale(1.2) rotate(-5deg); }
.nav-link.active {
  color: var(--link-color);
  background: linear-gradient(180deg, rgba(255,255,255,0.12), rgba(255,255,255,0.05));
  border-color: rgba(255,255,255,0.14);
  font-weight: 600;
}

/* Actions */
.nav-actions {
  display: flex; align-items: center; gap: var(--space-sm);
  flex-shrink: 0;
}

.nav-icon-btn {
  width: 34px; height: 34px;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--radius-md);
  font-size: 0.75rem;
  font-weight: 700;
  font-family: var(--font-mono);
  color: var(--text-secondary);
  cursor: pointer;
  transition: all var(--duration-fast);
  letter-spacing: 0.05em;
}
.nav-icon-btn:hover {
  background: var(--bg-elevated);
  color: var(--text-primary);
}

.nav-post-btn { gap: 4px; }

.nav-user-area {
  display: flex; align-items: center; gap: var(--space-sm);
}

.nav-avatar {
  display: flex; align-items: center; gap: 6px;
  padding: 4px 10px;
  background: rgba(255,255,255,0.07);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  transition: all var(--duration-fast);
}
.nav-avatar:hover {
  border-color: var(--border-hover);
  background: var(--bg-elevated);
}
.nav-avatar-emoji { font-size: 1.1rem; }
.nav-avatar-name { font-weight: 500; color: var(--text-primary); }

.nav-logout {
  font-size: 0.85rem;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px 6px;
  border-radius: var(--radius-sm);
  transition: color var(--duration-fast);
  border: 1px solid transparent;
}
.nav-logout:hover { color: var(--accent); border-color: var(--border-subtle); }

/* Hamburger */
.nav-hamburger {
  display: none;
  flex-direction: column; justify-content: center; gap: 5px;
  width: 34px; height: 34px;
  cursor: pointer;
  padding: 6px;
  border-radius: var(--radius-sm);
  transition: background var(--duration-fast);
}
.nav-hamburger:hover { background: var(--bg-elevated); }
.nav-hamburger span {
  display: block;
  width: 100%; height: 2px;
  background: var(--text-secondary);
  border-radius: 2px;
  transition: all var(--duration-normal) var(--ease-out);
  transform-origin: center;
}
.nav-hamburger.open span:nth-child(1) { transform: rotate(45deg) translate(5px,5px); }
.nav-hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.nav-hamburger.open span:nth-child(3) { transform: rotate(-45deg) translate(5px,-5px); }

@media (max-width: 720px) {
  .nav-inner {
    max-width: 100vw;
    min-width: 0;
    gap: var(--space-sm);
    padding-left: 10px;
    padding-right: 10px;
  }

  .nav-brand {
    min-width: 0;
    max-width: 88px;
    overflow: hidden;
  }

  .brand-icon {
    font-size: 1.18rem;
  }

  .brand-sub {
    font-size: 0.9rem;
  }

  .nav-actions {
    min-width: 0;
    flex: 1;
    justify-content: flex-end;
    gap: 6px;
  }

  .nav-icon-btn {
    width: 30px;
    height: 30px;
  }

  .nav-user-area {
    min-width: 0;
    gap: 6px;
  }

  .nav-avatar {
    width: 46px;
    padding: 3px 8px;
    justify-content: center;
  }

  .nav-avatar-name,
  .nav-logout {
    display: none;
  }

  .nav-post-btn {
    min-width: 0;
    padding: 7px 10px;
  }

  .nav-post-btn span:first-child {
    display: none;
  }

  .nav-hamburger {
    display: flex;
    flex: 0 0 34px;
    margin-left: 0;
  }

  .nav-links {
    display: none;
    position: fixed; top: var(--nav-height); left: 0; right: 0;
    flex-direction: column; align-items: stretch;
    padding: var(--space-md);
    background: var(--bg-glass);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-subtle);
    gap: 4px; z-index: 99;
  }
  .nav-links.open { display: flex; }
  .nav-link { padding: 10px var(--space-md); border-radius: var(--radius-md); }
  .nav-link-text { font-size: var(--text-base); }
}

@media (max-width: 420px) {
  .nav-inner {
    padding-left: 8px;
    padding-right: 8px;
  }

  .nav-brand {
    max-width: 76px;
  }

  .brand-sub {
    max-width: 34px;
    overflow: hidden;
    text-overflow: clip;
    white-space: nowrap;
  }

  .nav-post-btn {
    padding: 7px 9px;
  }
}

/* ---- MAIN ---- */
.main-content {
  position: relative; z-index: 1;
  min-height: calc(100vh - var(--nav-height) - 100px);
  padding: var(--space-lg) 0 var(--space-3xl);
}

/* ---- FOOTER ---- */
.footer {
  position: relative; z-index: 1;
  border-top: 1px solid var(--border-subtle);
  padding: var(--space-xl) 0;
  background: rgba(5,6,8,0.72);
  backdrop-filter: blur(18px);
}
.footer-inner {
  display: flex; flex-direction: column; align-items: center;
  gap: var(--space-sm); text-align: center;
}
.footer-brand {
  font-size: 1.1rem; font-weight: 800; letter-spacing: 0;
}
.footer-f4 {
  background: linear-gradient(135deg, #e94560, #6c5ce7);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.footer-text { font-size: var(--text-sm); color: var(--text-muted); }
.footer-copy { font-size: var(--text-xs); color: var(--text-muted); font-family: var(--font-mono); }
</style>
</body>
</html>
