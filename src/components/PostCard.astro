---
// 奉天F4Club - Post Card Component
import MemberBadge from './MemberBadge.astro';
import CategoryTag from './CategoryTag.astro';
import type { Post } from '../lib/db';
import { timeAgo } from '../lib/i18n';

interface Props {
  post: Post;
  lang?: 'zh' | 'en';
  index?: number;
}

const { post, lang = 'zh', index = 0 } = Astro.props;

const firstImageMatch = post.content.match(/!\[.*?\]\((.*?)\)/);
const thumbnailUrl = firstImageMatch ? firstImageMatch[1] : null;

const preview = post.content
  .replace(/!\[.*?\]\(.*?\)/g, '')
  .replace(/[#*`\[\]!()]/g, '')
  .replace(/\n{3,}/g, '\n\n')
  .slice(0, 100)
  .trim();

const categoryEmoji: Record<string, string> = {
  gaming: '🎮',
  movies: '🎬',
  music: '🎵',
  sports: '🏀',
  english: '📚',
};

const cardClass = `post-card post-card-${post.category}`;
---

<article class={`${cardClass} animate-fade-in delay-${Math.min(index + 1, 5)}`}>
  <a href={`/post/${post.id}`} class="post-card-link">
    <span class="post-card-accent" aria-hidden="true"></span>

    <!-- 图片区 + 作者信息叠加 -->
    <div class={`post-media ${thumbnailUrl ? 'has-image' : 'is-generated'}`}>
      {thumbnailUrl ? (
        <>
          <img class="media-backdrop" src={thumbnailUrl} alt="" loading="lazy" aria-hidden="true" />
          <img class="media-image" src={thumbnailUrl} alt="" loading="lazy" />
        </>
      ) : (
        <>
          <span class="media-symbol">{categoryEmoji[post.category] || '✦'}</span>
          <span class="media-grid" aria-hidden="true"></span>
        </>
      )}
      <!-- 作者 + 时间 overlay（图片底部玻璃条） -->
      <div class="media-meta">
        <MemberBadge
          nickname={post.author_nickname || ''}
          emoji={post.author_emoji || '👤'}
          size="sm"
          linked={false}
        />
        <span class="post-time">{timeAgo(post.created_at, lang)}</span>
      </div>
    </div>

    <!-- 正文区 -->
    <div class="post-card-body">
      <h3 class="post-title">{post.title}</h3>
      {preview && <p class="post-preview">{preview}{post.content.length > 100 ? '…' : ''}</p>}

      <div class="post-card-footer">
        <CategoryTag category={post.category} sportType={post.sport_type} lang={lang} />
        <div class="post-stats">
          <span class="stat" title={lang === 'zh' ? '赞' : 'Likes'}>
            <span>♥</span>{post.like_count || 0}
          </span>
          <span class="stat" title={lang === 'zh' ? '评论' : 'Comments'}>
            <span>↗</span>{post.comment_count || 0}
          </span>
        </div>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    --card-accent: var(--accent);
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.035));
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal),
      box-shadow var(--duration-normal),
      background var(--duration-normal);
    backdrop-filter: blur(18px) saturate(130%);
  }

  .post-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, color-mix(in srgb, var(--card-accent) 18%, transparent), transparent 46%);
    opacity: 0.62;
    pointer-events: none;
  }

  .post-card-gaming  { --card-accent: var(--cat-gaming); }
  .post-card-movies  { --card-accent: var(--cat-movies); }
  .post-card-music   { --card-accent: var(--cat-music); }
  .post-card-sports  { --card-accent: var(--cat-sports); }
  .post-card-english { --card-accent: var(--cat-english); }

  .post-card:hover {
    background: linear-gradient(180deg, rgba(255,255,255,0.11), rgba(255,255,255,0.05));
    border-color: color-mix(in srgb, var(--card-accent) 44%, rgba(255,255,255,0.12));
    transform: translateY(-4px);
    box-shadow: 0 18px 46px rgba(0,0,0,0.34), 0 0 0 1px color-mix(in srgb, var(--card-accent) 18%, transparent);
  }

  /* 卡片整体用 flex 列，高度由内容决定，不再强制拉伸 */
  .post-card-link {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .post-card-accent {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(180deg, var(--card-accent), transparent);
    opacity: 0.9;
    z-index: 2;
  }

  /* ---- 图片区 ---- */
  .post-media {
    position: relative;
    height: 168px;
    overflow: hidden;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    flex-shrink: 0;
  }

  .post-media.has-image img {
    display: block;
  }

  .post-media.has-image .media-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(18px) saturate(1.18);
    opacity: 0.42;
    transform: scale(1.12);
  }

  .post-media.has-image .media-image {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: rgba(5,7,11,0.2);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .post-card:hover .post-media.has-image .media-image {
    transform: scale(1.03);
  }

  .post-media.is-generated {
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--card-accent) 22%, transparent), rgba(255,255,255,0.03)),
      linear-gradient(180deg, rgba(255,255,255,0.06), transparent);
  }

  .media-symbol {
    position: relative;
    z-index: 1;
    font-size: 2.5rem;
    filter: drop-shadow(0 12px 24px rgba(0,0,0,0.42));
  }

  .media-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(180deg, rgba(0,0,0,0.64), transparent);
  }

  /* 作者 + 时间 overlay */
  .media-meta {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px var(--space-md);
    background: linear-gradient(0deg, rgba(5,7,11,0.82) 0%, rgba(5,7,11,0.18) 100%);
    backdrop-filter: blur(6px);
  }

  .post-time {
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.6);
    font-family: var(--font-mono);
  }

  /* ---- 正文区 ---- */
  .post-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
  }

  .post-title {
    font-size: var(--text-base);
    font-weight: 700;
    line-height: var(--leading-tight);
    color: var(--text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-preview {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-top: var(--space-xs);
    border-top: 1px solid rgba(255,255,255,0.06);
    margin-top: var(--space-xs);
  }

  /* 限制标签最大宽度，防止过长 */
  .post-card-footer :global(.tag) {
    max-width: 130px;
    overflow: hidden;
    white-space: nowrap;
    flex-shrink: 1;
    min-width: 0;
  }

  .post-stats {
    display: flex;
    gap: var(--space-xs);
    flex-shrink: 0;
  }

  .stat {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 26px;
    padding: 0 8px;
    border-radius: var(--radius-md);
    color: var(--text-muted);
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.07);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .post-media {
      height: 140px;
    }
    .post-card-body {
      padding: var(--space-sm) var(--space-md);
    }
  }
</style>
