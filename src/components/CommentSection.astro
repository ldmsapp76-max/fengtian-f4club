---
// 奉天F4Club — Comment Section Component
import MemberBadge from './MemberBadge.astro';
import type { Comment } from '../lib/db';
import { timeAgo } from '../lib/i18n';

interface Props {
  comments: Comment[];
  postId: number;
  user?: { id: number; nickname: string; avatar_emoji: string } | null;
  lang?: 'zh' | 'en';
}

const { comments, postId, user, lang = 'zh' } = Astro.props;
---

<section class="comment-section" id="comments" data-post-id={postId} data-lang={lang}>
  <h3 class="comment-title">
    {lang === 'zh' ? '评论' : 'Comments'}
    <span class="comment-count" id="comment-count">{comments.length}</span>
  </h3>

  <!-- Comment Form -->
  {user ? (
    <form class="comment-form" id="comment-form" data-post-id={postId}>
      <div class="comment-form-header">
        <span class="comment-avatar">{user.avatar_emoji}</span>
        <span class="comment-author">{user.nickname}</span>
      </div>
      <textarea
        class="input comment-input"
        id="comment-input"
        placeholder={lang === 'zh' ? '说点什么...' : 'Say something...'}
        rows="3"
      ></textarea>
      <div class="comment-form-actions">
        <button type="submit" class="btn btn-primary btn-sm">
          {lang === 'zh' ? '发表' : 'Post'}
        </button>
      </div>
    </form>
  ) : (
    <div class="comment-login-prompt">
      <a href="/login" class="btn btn-ghost btn-sm">
        {lang === 'zh' ? '🔐 登录后才能评论' : '🔐 Login to comment'}
      </a>
    </div>
  )}

  <!-- Comment List -->
  <div class="comment-list" id="comment-list">
    {comments.length === 0 ? (
      <div class="empty-state">
        <p>{lang === 'zh' ? '评论加载中...' : 'Loading comments...'}</p>
      </div>
    ) : (
      comments.map((comment) => (
        <div class="comment-item animate-fade-in">
          <div class="comment-item-header">
            <MemberBadge
              nickname={comment.author_nickname || ''}
              emoji={comment.author_emoji || '👤'}
              size="sm"
            />
            <span class="comment-time">{timeAgo(comment.created_at, lang)}</span>
          </div>
          <div class="comment-content">{comment.content}</div>
        </div>
      ))
    )}
  </div>
</section>

<!-- Comment Submit Script -->
<script is:inline data-astro-rerun>
(function initComments() {
  const section = document.getElementById('comments');
  if (!section || section.dataset.ready === 'true') return;
  section.dataset.ready = 'true';

  const form = document.getElementById('comment-form');
  const input = document.getElementById('comment-input');
  const list = document.getElementById('comment-list');
  const count = document.getElementById('comment-count');
  const lang = section?.dataset.lang || 'zh';

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function relativeTime(value) {
    const seconds = Math.max(0, Math.floor((Date.now() - new Date(value).getTime()) / 1000));
    if (seconds < 60) return lang === 'zh' ? '刚刚' : 'just now';
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return lang === 'zh' ? `${minutes}分钟前` : `${minutes}m ago`;
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return lang === 'zh' ? `${hours}小时前` : `${hours}h ago`;
    const days = Math.floor(hours / 24);
    return lang === 'zh' ? `${days}天前` : `${days}d ago`;
  }

  function renderComment(comment) {
    const nickname = escapeHtml(comment.author_nickname || '');
    const emoji = escapeHtml(comment.author_emoji || '👤');
    const content = escapeHtml(comment.content || '');
    return `
      <div class="comment-item animate-fade-in">
        <div class="comment-item-header">
          <div class="comment-member">
            <span class="comment-member-emoji">${emoji}</span>
            <span class="comment-member-name">${nickname}</span>
          </div>
          <span class="comment-time">${relativeTime(comment.created_at)}</span>
        </div>
        <div class="comment-content">${content}</div>
      </div>
    `;
  }

  function renderComments(comments) {
    if (!list) return;
    if (count) count.textContent = String(comments.length);
    if (comments.length === 0) {
      list.innerHTML = `<div class="empty-state"><p>${lang === 'zh' ? '还没有评论，来说第一句吧' : 'No comments yet, be the first'}</p></div>`;
      return;
    }
    list.innerHTML = comments.map(renderComment).join('');
  }

  async function loadComments() {
    if (!section || section.dataset.loaded === 'true') return;
    section.dataset.loaded = 'true';
    const postId = section.dataset.postId;
    try {
      const res = await fetch(`/api/comments?postId=${postId}`, {
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error('Failed to load comments');
      const data = await res.json();
      renderComments(data.comments || []);
    } catch (error) {
      if (list) {
        list.innerHTML = `<div class="empty-state"><p>${lang === 'zh' ? '评论暂时加载失败' : 'Comments failed to load'}</p></div>`;
      }
    }
  }

  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(loadComments, { timeout: 900 });
  } else {
    setTimeout(loadComments, 250);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const postId = form.dataset.postId;
    const content = input?.value?.trim();
    if (!content) return;

    const submitBtn = form.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    submitBtn.textContent = '...';

    try {
      const res = await fetch('/api/comments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ postId: Number(postId), content }),
      });

      if (res.ok) {
        const data = await res.json();
        section.dataset.loaded = 'true';
        const currentCount = Number(count?.textContent || 0);
        if (list) {
          const wasEmpty = list.querySelector('.empty-state');
          if (wasEmpty) list.innerHTML = '';
          list.insertAdjacentHTML('beforeend', renderComment(data.comment));
        }
        if (count) count.textContent = String(currentCount + 1);
        input.value = '';
      } else {
        const data = await res.json();
        alert(data.error || 'Failed to post comment');
      }
    } catch (err) {
      alert('Network error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '发表';
    }
  });
})();
</script>

<style>
  .comment-section {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border-subtle);
  }

  .comment-title {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .comment-count {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
    background: var(--bg-elevated);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .comment-form {
    margin-bottom: var(--space-xl);
  }

  .comment-form-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .comment-avatar {
    font-size: 1.5rem;
  }

  .comment-author {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .comment-input {
    font-family: var(--font-sans);
    min-height: 80px;
  }

  .comment-form-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-sm);
  }

  .comment-login-prompt {
    text-align: center;
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
    background: var(--bg-card);
    border-radius: var(--radius-md);
    border: 1px dashed var(--border-default);
  }

  .comment-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .comment-item {
    padding: var(--space-md);
    background: var(--bg-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .comment-item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
  }

  .comment-member {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .comment-member-emoji {
    font-size: 1rem;
    line-height: 1;
  }

  .comment-member-name {
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .comment-time {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .comment-content {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .empty-state {
    padding: var(--space-xl);
  }
</style>
