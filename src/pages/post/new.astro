---
// 奉天F4Club — New Post Page
import Layout from '../../layouts/Layout.astro';

const user = (Astro.locals as any).user;
const lang = (Astro.url.searchParams.get('lang') as 'zh' | 'en') || 'zh';

// Redirect to login if not authenticated
if (!user) {
  return Astro.redirect('/login');
}
---

<Layout title={lang === 'zh' ? '发布新帖' : 'New Post'} lang={lang}>
  <div class="container page-content">
    <div class="new-post animate-slide-up">
      <a href="/" class="back-link">← {lang === 'zh' ? '返回' : 'Back'}</a>

      <h1 class="page-title">{lang === 'zh' ? '发布新帖' : 'New Post'}</h1>

      <form id="post-form" class="post-form">
        <!-- Title -->
        <div class="form-group">
          <label class="label" for="post-title">
            {lang === 'zh' ? '标题' : 'Title'}
          </label>
          <input
            type="text"
            id="post-title"
            class="input"
            placeholder={lang === 'zh' ? '起个标题...' : 'Give it a title...'}
            required
          />
        </div>

        <!-- Category -->
        <div class="form-row">
          <div class="form-group" style="flex:1">
            <label class="label" for="post-category">
              {lang === 'zh' ? '分类' : 'Category'}
            </label>
            <select id="post-category" class="select" required>
              <option value="gaming">🎮 {lang === 'zh' ? '游戏' : 'Gaming'}</option>
              <option value="movies">🎬 {lang === 'zh' ? '电影' : 'Movies'}</option>
              <option value="music">🎵 {lang === 'zh' ? '音乐' : 'Music'}</option>
              <option value="sports">🏀 {lang === 'zh' ? '运动' : 'Sports'}</option>
              <option value="english">📖 {lang === 'zh' ? '学英语' : 'English'}</option>
            </select>
          </div>

          <div class="form-group" id="sport-type-group" style="flex:1;display:none">
            <label class="label" for="sport-type">
              {lang === 'zh' ? '运动类型' : 'Sport Type'}
            </label>
            <select id="sport-type" class="select">
              <option value="">—</option>
              <option value="basketball">🏀 {lang === 'zh' ? '篮球' : 'Basketball'}</option>
              <option value="badminton">🏸 {lang === 'zh' ? '羽毛球' : 'Badminton'}</option>
              <option value="marathon">🏃 {lang === 'zh' ? '马拉松' : 'Marathon'}</option>
            </select>
          </div>
        </div>

        <!-- Image Upload -->
        <div class="form-group">
          <label class="label">
            {lang === 'zh' ? '上传图片' : 'Upload Image'}
          </label>
          <div class="upload-area" id="upload-area">
            <input type="file" id="file-input" accept="image/*" style="display:none" />
            <button type="button" class="btn btn-ghost btn-sm" id="upload-btn">
              📷 {lang === 'zh' ? '选择图片' : 'Choose Image'}
            </button>
            <span class="upload-status" id="upload-status"></span>
          </div>
          <div class="upload-preview" id="upload-preview"></div>
        </div>

        <!-- Content -->
        <div class="form-group">
          <label class="label" for="post-content">
            {lang === 'zh' ? '内容（支持 Markdown）' : 'Content (Markdown supported)'}
          </label>
          <div class="editor-toolbar">
            <button type="button" class="toolbar-btn" data-action="bold" title="Bold">B</button>
            <button type="button" class="toolbar-btn" data-action="italic" title="Italic">I</button>
            <button type="button" class="toolbar-btn" data-action="code" title="Code">&lt;/&gt;</button>
            <button type="button" class="toolbar-btn" data-action="link" title="Link">🔗</button>
            <button type="button" class="toolbar-btn" data-action="heading" title="Heading">H</button>
          </div>
          <textarea
            id="post-content"
            class="input content-editor"
            placeholder={lang === 'zh' ? '写点什么...\n\n支持 Markdown 语法' : 'Write something...\n\nMarkdown supported'}
            rows="12"
            required
          ></textarea>
        </div>

        <!-- Submit -->
        <div class="form-actions">
          <button type="submit" class="btn btn-primary" id="submit-btn">
            {lang === 'zh' ? '🚀 发布' : '🚀 Publish'}
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script is:inline data-astro-rerun>
(function initNewPostPage() {
  const form = document.getElementById('post-form');
  if (!form || form.dataset.newPostReady === 'true') return;
  form.dataset.newPostReady = 'true';

  const categorySelect = document.getElementById('post-category');
  const sportGroup = document.getElementById('sport-type-group');
  const uploadBtn = document.getElementById('upload-btn');
  const fileInput = document.getElementById('file-input');
  const uploadStatus = document.getElementById('upload-status');
  const uploadPreview = document.getElementById('upload-preview');
  const contentEditor = document.getElementById('post-content');

  // Show/hide sport type based on category
  categorySelect?.addEventListener('change', () => {
    sportGroup.style.display = categorySelect.value === 'sports' ? 'block' : 'none';
  });

  // Image upload
  uploadBtn?.addEventListener('click', () => fileInput.click());

  function formatFileSize(bytes) {
    if (bytes < 1024 * 1024) {
      return `${Math.round(bytes / 1024)}KB`;
    }
    return `${(bytes / 1024 / 1024).toFixed(1)}MB`;
  }

  async function compressImageFile(file) {
    const compressibleTypes = ['image/jpeg', 'image/png', 'image/webp'];
    if (!compressibleTypes.includes(file.type)) {
      return { file, originalSize: file.size, compressed: false };
    }

    const imageUrl = URL.createObjectURL(file);
    const image = new Image();
    image.decoding = 'async';

    try {
      await new Promise((resolve, reject) => {
        image.onload = resolve;
        image.onerror = reject;
        image.src = imageUrl;
      });

      const maxSide = 1920;
      const scale = Math.min(1, maxSide / Math.max(image.naturalWidth, image.naturalHeight));
      const width = Math.max(1, Math.round(image.naturalWidth * scale));
      const height = Math.max(1, Math.round(image.naturalHeight * scale));

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(image, 0, 0, width, height);

      const blob = await new Promise((resolve) => {
        canvas.toBlob(resolve, 'image/webp', 0.82);
      });

      if (!blob || blob.size >= file.size) {
        return { file, originalSize: file.size, compressed: false };
      }

      const baseName = file.name.replace(/\.[^.]+$/, '') || 'image';
      const compressedFile = new File([blob], `${baseName}.webp`, { type: 'image/webp' });
      return { file: compressedFile, originalSize: file.size, compressed: true };
    } finally {
      URL.revokeObjectURL(imageUrl);
    }
  }

  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files[0];
    if (!file) return;

    uploadStatus.textContent = '压缩中...';
    uploadBtn.disabled = true;

    try {
      const uploadFile = await compressImageFile(file);
      uploadStatus.textContent = '上传中...';

      const formData = new FormData();
      formData.append('file', uploadFile.file);

      const res = await fetch('/api/upload', {
        method: 'POST',
        body: formData,
      });

      if (res.ok) {
        const data = await res.json();
        // Insert markdown image at cursor
        const imgMd = `![${file.name}](${data.url})`;
        const pos = contentEditor.selectionStart;
        const before = contentEditor.value.substring(0, pos);
        const after = contentEditor.value.substring(pos);
        contentEditor.value = before + '\n' + imgMd + '\n' + after;

        // Show preview
        const img = document.createElement('img');
        img.src = data.url;
        img.style.maxWidth = '200px';
        img.style.borderRadius = '8px';
        img.style.marginTop = '8px';
        uploadPreview.appendChild(img);

        const savedText = uploadFile.compressed
          ? `，${formatFileSize(uploadFile.originalSize)} → ${formatFileSize(uploadFile.file.size)}`
          : '';
        uploadStatus.textContent = '✓ ' + file.name + savedText;
      } else {
        const data = await res.json();
        uploadStatus.textContent = '✗ ' + (data.error || 'Upload failed');
      }
    } catch (err) {
      uploadStatus.textContent = '✗ Network error';
    } finally {
      uploadBtn.disabled = false;
      fileInput.value = '';
    }
  });

  // Markdown toolbar
  document.querySelectorAll('.toolbar-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.action;
      const start = contentEditor.selectionStart;
      const end = contentEditor.selectionEnd;
      const selected = contentEditor.value.substring(start, end);

      let replacement = '';
      switch (action) {
        case 'bold':
          replacement = `**${selected || '粗体'}**`;
          break;
        case 'italic':
          replacement = `*${selected || '斜体'}*`;
          break;
        case 'code':
          replacement = selected.includes('\n')
            ? `\`\`\`\n${selected || 'code'}\n\`\`\``
            : `\`${selected || 'code'}\``;
          break;
        case 'link':
          replacement = `[${selected || '链接文字'}](https://)`;
          break;
        case 'heading':
          replacement = `## ${selected || '标题'}`;
          break;
      }

      contentEditor.value =
        contentEditor.value.substring(0, start) +
        replacement +
        contentEditor.value.substring(end);
      contentEditor.focus();
    });
  });

  // Submit form
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const title = document.getElementById('post-title').value.trim();
    const content = contentEditor.value.trim();
    const category = categorySelect.value;
    const sportType = document.getElementById('sport-type')?.value || '';

    if (!title || !content) return;

    const submitBtn = document.getElementById('submit-btn');
    submitBtn.disabled = true;
    submitBtn.textContent = '...';

    try {
      const res = await fetch('/api/posts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, content, category, sportType }),
      });

      if (res.ok) {
        const data = await res.json();
        window.location.href = `/post/${data.id}`;
      } else {
        const data = await res.json();
        alert(data.error || 'Failed to create post');
      }
    } catch (err) {
      alert('Network error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '🚀 发布';
    }
  });
})();
</script>

<style>
  .new-post {
    max-width: 720px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-xl);
    transition: color var(--duration-fast);
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  .page-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-xl);
  }

  .form-row {
    display: flex;
    gap: var(--space-md);
  }

  @media (max-width: 640px) {
    .form-row {
      flex-direction: column;
    }
  }

  .upload-area {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .upload-status {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .editor-toolbar {
    display: flex;
    gap: 2px;
    margin-bottom: var(--space-xs);
    padding: var(--space-xs);
    background: var(--bg-card);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    border: 1px solid var(--border-subtle);
    border-bottom: none;
  }

  .toolbar-btn {
    width: 32px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast);
    font-family: var(--font-mono);
    background: none;
    border: none;
  }

  .toolbar-btn:hover {
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  .content-editor {
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    min-height: 200px;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--space-md);
  }

  .form-actions .btn {
    padding: var(--space-sm) var(--space-2xl);
  }
</style>
