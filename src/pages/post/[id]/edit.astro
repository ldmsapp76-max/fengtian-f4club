---
import Layout from '../../../layouts/Layout.astro';
import { getPostById } from '../../../lib/db';

const { id } = Astro.params;
const user = (Astro.locals as any).user;
const lang = (Astro.url.searchParams.get('lang') as 'zh' | 'en') || 'zh';

if (!user) {
  return Astro.redirect('/login');
}

let post: any = null;

try {
  const runtime = (Astro.locals as any).runtime;
  if (runtime?.env?.DB) {
    post = await getPostById(runtime.env.DB, Number(id), user.id);
  }
} catch (e) {
  console.error('Failed to load post for edit:', e);
}

if (!post) {
  return Astro.redirect('/');
}

if (post.author_id !== user.id) {
  return Astro.redirect(`/post/${post.id}`);
}
---

<Layout title={lang === 'zh' ? '编辑帖子' : 'Edit Post'} lang={lang}>
  <div class="container page-content">
    <div class="edit-post animate-slide-up">
      <a href={`/post/${post.id}`} class="back-link">← {lang === 'zh' ? '返回帖子' : 'Back to post'}</a>

      <h1 class="page-title">{lang === 'zh' ? '编辑帖子' : 'Edit Post'}</h1>

      <form id="post-form" class="post-form" data-post-id={post.id}>
        <div class="form-group">
          <label class="label" for="post-title">{lang === 'zh' ? '标题' : 'Title'}</label>
          <input type="text" id="post-title" class="input" value={post.title} required />
        </div>

        <div class="form-row">
          <div class="form-group" style="flex:1">
            <label class="label" for="post-category">{lang === 'zh' ? '分类' : 'Category'}</label>
            <select id="post-category" class="select" required>
              <option value="gaming" selected={post.category === 'gaming'}>🎮 {lang === 'zh' ? '游戏' : 'Gaming'}</option>
              <option value="movies" selected={post.category === 'movies'}>🎬 {lang === 'zh' ? '电影' : 'Movies'}</option>
              <option value="sports" selected={post.category === 'sports'}>🏀 {lang === 'zh' ? '运动' : 'Sports'}</option>
              <option value="english" selected={post.category === 'english'}>📚 {lang === 'zh' ? '学英语' : 'English'}</option>
            </select>
          </div>

          <div class="form-group" id="sport-type-group" style={`flex:1;display:${post.category === 'sports' ? 'block' : 'none'}`}>
            <label class="label" for="sport-type">{lang === 'zh' ? '运动类型' : 'Sport Type'}</label>
            <select id="sport-type" class="select">
              <option value="" selected={!post.sport_type}>-</option>
              <option value="basketball" selected={post.sport_type === 'basketball'}>🏀 {lang === 'zh' ? '篮球' : 'Basketball'}</option>
              <option value="badminton" selected={post.sport_type === 'badminton'}>🏸 {lang === 'zh' ? '羽毛球' : 'Badminton'}</option>
              <option value="marathon" selected={post.sport_type === 'marathon'}>🏃 {lang === 'zh' ? '马拉松' : 'Marathon'}</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="label">{lang === 'zh' ? '上传图片' : 'Upload Image'}</label>
          <div class="upload-area" id="upload-area">
            <input type="file" id="file-input" accept="image/*" style="display:none" />
            <button type="button" class="btn btn-ghost btn-sm" id="upload-btn">
              📷 {lang === 'zh' ? '选择图片' : 'Choose Image'}
            </button>
            <span class="upload-status" id="upload-status"></span>
          </div>
          <div class="upload-preview" id="upload-preview"></div>
        </div>

        <div class="form-group">
          <label class="label" for="post-content">
            {lang === 'zh' ? '内容（支持 Markdown）' : 'Content (Markdown supported)'}
          </label>
          <div class="editor-toolbar">
            <button type="button" class="toolbar-btn" data-action="bold" title="Bold">B</button>
            <button type="button" class="toolbar-btn" data-action="italic" title="Italic">I</button>
            <button type="button" class="toolbar-btn" data-action="code" title="Code">&lt;/&gt;</button>
            <button type="button" class="toolbar-btn" data-action="link" title="Link">🔗</button>
            <button type="button" class="toolbar-btn" data-action="heading" title="Heading">H</button>
          </div>
          <textarea id="post-content" class="input content-editor" rows="12" required>{post.content}</textarea>
        </div>

        <div class="form-actions">
          <a href={`/post/${post.id}`} class="btn btn-ghost">{lang === 'zh' ? '取消' : 'Cancel'}</a>
          <button type="submit" class="btn btn-primary" id="submit-btn">
            {lang === 'zh' ? '保存' : 'Save'}
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script is:inline>
  const form = document.getElementById('post-form');
  const categorySelect = document.getElementById('post-category');
  const sportGroup = document.getElementById('sport-type-group');
  const uploadBtn = document.getElementById('upload-btn');
  const fileInput = document.getElementById('file-input');
  const uploadStatus = document.getElementById('upload-status');
  const uploadPreview = document.getElementById('upload-preview');
  const contentEditor = document.getElementById('post-content');

  categorySelect?.addEventListener('change', () => {
    sportGroup.style.display = categorySelect.value === 'sports' ? 'block' : 'none';
  });

  uploadBtn?.addEventListener('click', () => fileInput.click());

  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files[0];
    if (!file) return;

    uploadStatus.textContent = '上传中...';
    uploadBtn.disabled = true;

    try {
      const formData = new FormData();
      formData.append('file', file);

      const res = await fetch('/api/upload', {
        method: 'POST',
        body: formData,
      });

      if (res.ok) {
        const data = await res.json();
        const imgMd = `![${file.name}](${data.url})`;
        const pos = contentEditor.selectionStart;
        contentEditor.value =
          contentEditor.value.substring(0, pos) +
          '\n' + imgMd + '\n' +
          contentEditor.value.substring(pos);

        const img = document.createElement('img');
        img.src = data.url;
        img.style.maxWidth = '200px';
        img.style.borderRadius = '8px';
        img.style.marginTop = '8px';
        uploadPreview.appendChild(img);
        uploadStatus.textContent = '✓ ' + file.name;
      } else {
        const data = await res.json();
        uploadStatus.textContent = '✗ ' + (data.error || 'Upload failed');
      }
    } catch (err) {
      uploadStatus.textContent = '✗ Network error';
    } finally {
      uploadBtn.disabled = false;
      fileInput.value = '';
    }
  });

  document.querySelectorAll('.toolbar-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.action;
      const start = contentEditor.selectionStart;
      const end = contentEditor.selectionEnd;
      const selected = contentEditor.value.substring(start, end);

      let replacement = '';
      switch (action) {
        case 'bold':
          replacement = `**${selected || '粗体'}**`;
          break;
        case 'italic':
          replacement = `*${selected || '斜体'}*`;
          break;
        case 'code':
          replacement = selected.includes('\n')
            ? `\`\`\`\n${selected || 'code'}\n\`\`\``
            : `\`${selected || 'code'}\``;
          break;
        case 'link':
          replacement = `[${selected || '链接文字'}](https://)`;
          break;
        case 'heading':
          replacement = `## ${selected || '标题'}`;
          break;
      }

      contentEditor.value =
        contentEditor.value.substring(0, start) +
        replacement +
        contentEditor.value.substring(end);
      contentEditor.focus();
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const postId = form.dataset.postId;
    const title = document.getElementById('post-title').value.trim();
    const content = contentEditor.value.trim();
    const category = categorySelect.value;
    const sportType = category === 'sports' ? (document.getElementById('sport-type')?.value || '') : '';

    if (!title || !content) return;

    const submitBtn = document.getElementById('submit-btn');
    submitBtn.disabled = true;
    submitBtn.textContent = '...';

    try {
      const res = await fetch(`/api/posts/${postId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, content, category, sportType }),
      });

      if (res.ok) {
        window.location.href = `/post/${postId}`;
      } else {
        const data = await res.json();
        alert(data.error || 'Failed to save post');
      }
    } catch (err) {
      alert('Network error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = document.documentElement.lang === 'zh-CN' ? '保存' : 'Save';
    }
  });
</script>

<style>
  .edit-post {
    max-width: 720px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-xl);
    transition: color var(--duration-fast);
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  .page-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-xl);
  }

  .form-row {
    display: flex;
    gap: var(--space-md);
  }

  @media (max-width: 640px) {
    .form-row {
      flex-direction: column;
    }
  }

  .upload-area {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .upload-status {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .editor-toolbar {
    display: flex;
    gap: 2px;
    margin-bottom: var(--space-xs);
    padding: var(--space-xs);
    background: var(--bg-card);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    border: 1px solid var(--border-subtle);
    border-bottom: none;
  }

  .toolbar-btn {
    width: 32px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast);
    font-family: var(--font-mono);
    background: none;
    border: none;
  }

  .toolbar-btn:hover {
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  .content-editor {
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    min-height: 200px;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-sm);
    padding-top: var(--space-md);
  }

  .form-actions .btn {
    padding: var(--space-sm) var(--space-xl);
  }
</style>
